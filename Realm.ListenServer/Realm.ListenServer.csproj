<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Realm.ListenServer</RootNamespace>
    <AssemblyName>Realm.ListenServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Realm.Shared\Realm.Shared.csproj" />
    <ProjectReference Include="..\Realm.Ecs\Realm.Ecs.csproj" />
    <ProjectReference Include="..\Realm.MapAPI\Realm.MapAPI.csproj" />
  </ItemGroup>

</Project>
