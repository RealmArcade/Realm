<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Realm.Godot\Realm.Godot.csproj" />
    <ProjectReference Include="..\Realm.Ecs\Realm.Ecs.csproj" />
    <ProjectReference Include="..\Realm.Shared\Realm.Shared.csproj" />
    <ProjectReference Include="..\Realm.MapAPI\Realm.MapAPI.csproj" />
    <ProjectReference Include="..\Realm.EditorAPI\Realm.EditorAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FbxAnimationConversionTests.cs" />
    <Compile Include="MapEditorUxTests.cs" />
    <Compile Include="SimulationTests.cs" />
    <Compile Include="UxSceneTests.cs" />
  </ItemGroup>
</Project>
