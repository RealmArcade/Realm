<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <Target Name="CopyToMapTemplate" AfterTargets="Build">
    <ItemGroup>
      <_EditorApiOutput Include="$(TargetDir)$(TargetName).dll" />
      <_EditorApiOutput Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <_EditorApiOutput Include="$(TargetDir)$(TargetName).xml" Condition="Exists('$(TargetDir)$(TargetName).xml')" />
    </ItemGroup>
    <Copy SourceFiles="@(_EditorApiOutput)" DestinationFolder="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)\..\MapTemplate\lib'))\" SkipUnchangedFiles="true" />
  </Target>

</Project>
