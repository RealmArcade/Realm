{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Simulation Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Client.Tests/Realm.Client.Tests.csproj",
        "--filter",
        "FullyQualifiedName~SimulationTests"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GODOT_BIN": "${env:GODOT_BIN}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run All Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Client.Tests/Realm.Client.Tests.csproj"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GODOT_BIN": "${env:GODOT_BIN}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to Realm Game Host (.NET Core)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Attach to Listen Server (.NET Core)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": false
    }
  ]
}
