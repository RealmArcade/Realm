{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run AdminServer (Web)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Realm.AdminServer/Realm.AdminServer.csproj",
        "--urls",
        "http://0.0.0.0:5000"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Simulation Tests",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.ClientRealm.Client.csproj",
        "--filter",
        "FullyQualifiedName~SimulationTests"
      ],
      "options": {
        "env": {
          "GODOT_BIN": "C:\\Program Files\\Godot_v4.7-stable_mono_win64\\Godot_v4.7-stable_mono_win64.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.ClientRealm.Client.csproj"
      ],
      "options": {
        "env": {
          "GODOT_BIN": "C:\\Program Files\\Godot_v4.7-stable_mono_win64\\Godot_v4.7-stable_mono_win64.exe"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build WASM Map Script (Debug)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/MapTemplate/MapScript.csproj",
        "-c",
        "Debug",
        "-r",
        "wasi-wasm"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$msCompile",
      "detail": "Builds the WASM map script in Debug configuration with DWARF symbols retained."
    }
  ]
}
