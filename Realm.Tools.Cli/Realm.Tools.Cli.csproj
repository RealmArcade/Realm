<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">linux-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AssetGeneration_Program.cs" />
    <None Remove="AssetGeneration_Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Realm.Shared\Realm.Shared.csproj" />
  </ItemGroup>




  <Target Name="PublishSingleFileAfterBuild" AfterTargets="Build" Condition="'$(IsPublishingSingleFile)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="PublishDir=$(TargetDir)publish\;Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);IsPublishingSingleFile=true" />
    <Copy SourceFiles="$(TargetDir)publish\$(AssemblyName).exe" DestinationFolder="$(TargetDir)" Condition="Exists('$(TargetDir)publish\$(AssemblyName).exe')" />
  </Target>
</Project>
