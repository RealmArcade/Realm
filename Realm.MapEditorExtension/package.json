{
    "name":  "realm-map-editor",
    "displayName":  "Realm Map Editor",
    "description":  "Map project asset viewers, JSON schema validation and schema-driven authoring for Realm maps",
    "version":  "0.0.1",
    "publisher":  "speige",
    "engines":  {
                    "vscode":  "^1.75.0"
                },
    "categories":  [
                       "Other"
                   ],
    "activationEvents":  [
                             "onStartupFinished"
                         ],
    "main":  "./dist/extension.js",
    "contributes":  {
                        "languages":  [
                                          {
                                              "id":  "rtex",
                                              "aliases":  [
                                                              "Realm Texture",
                                                              "rtex"
                                                          ],
                                              "extensions":  [
                                                                 ".rtex"
                                                             ],
                                              "icon":  {
                                                           "light":  "./media/icons/rtex.svg",
                                                           "dark":  "./media/icons/rtex.svg"
                                                       }
                                          },
                                          {
                                              "id":  "ranim",
                                              "aliases":  [
                                                              "Realm Animation",
                                                              "ranim"
                                                          ],
                                              "extensions":  [
                                                                 ".ranim"
                                                             ],
                                              "icon":  {
                                                           "light":  "./media/icons/ranim.svg",
                                                           "dark":  "./media/icons/ranim.svg"
                                                       }
                                          },
                                          {
                                              "id":  "rmesh",
                                              "aliases":  [
                                                              "Realm 3D Mesh",
                                                              "rmesh"
                                                          ],
                                              "extensions":  [
                                                                 ".rmesh"
                                                             ],
                                              "icon":  {
                                                           "light":  "./media/icons/rmesh.svg",
                                                           "dark":  "./media/icons/rmesh.svg"
                                                       }
                                          },
                                          {
                                              "id":  "raud",
                                              "aliases":  [
                                                              "Realm Audio",
                                                              "raud"
                                                          ],
                                              "extensions":  [
                                                                 ".raud"
                                                             ],
                                              "icon":  {
                                                           "light":  "./media/icons/raud.svg",
                                                           "dark":  "./media/icons/raud.svg"
                                                       }
                                          }
                                      ],
                        "iconThemes":  [
                                           {
                                               "id":  "realm-icons",
                                               "label":  "Realm Icons",
                                               "path":  "./media/icons/realm-icon-theme.json"
                                           }
                                       ],
                        "customEditors":  [
                                              {
                                                  "viewType":  "realm.metadataForm",
                                                  "displayName":  "Metadata Form",
                                                  "selector":  [
                                                                   {
                                                                       "filenamePattern":  "**/metadata.json"
                                                                   }
                                                               ],
                                                  "priority":  "default"
                                              },
                                              {
                                                  "viewType":  "realm.rtexViewer",
                                                  "displayName":  "Realm RTEX Texture Viewer",
                                                  "selector":  [
                                                                   {
                                                                       "filenamePattern":  "*.rtex"
                                                                   }
                                                               ],
                                                  "priority":  "default"
                                              },
                                              {
                                                  "viewType":  "realm.ranimViewer",
                                                  "displayName":  "Realm Animation Viewer",
                                                  "selector":  [
                                                                   {
                                                                       "filenamePattern":  "*.ranim"
                                                                   }
                                                               ],
                                                  "priority":  "default"
                                              },
                                              {
                                                  "viewType":  "realm.rmeshViewer",
                                                  "displayName":  "Realm 3D Mesh Viewer",
                                                  "selector":  [
                                                                   {
                                                                       "filenamePattern":  "*.rmesh"
                                                                   }
                                                               ],
                                                  "priority":  "default"
                                              },
                                              {
                                                  "viewType":  "realm.raudViewer",
                                                  "displayName":  "Realm Audio Player",
                                                  "selector":  [
                                                                   {
                                                                       "filenamePattern":  "*.raud"
                                                                   }
                                                               ],
                                                  "priority":  "default"
                                              }
                                          ],
                        "commands":  [
                                         {
                                             "command":  "realm.openMetadataForm",
                                             "title":  "Open Metadata as Form",
                                             "category":  "Realm"
                                         },
                                         {
                                             "command":  "realm.openRmesh3D",
                                             "title":  "Open in 3D GLB Viewer",
                                             "category":  "Realm"
                                         },
                                         {
                                             "command":  "realm.exportRanim",
                                             "title":  "Export Animation (.ranim)",
                                             "category":  "Realm"
                                         }
                                     ],
                        "menus":  {
                                      "explorer/context":  [
                                                               {
                                                                   "command":  "realm.openMetadataForm",
                                                                   "when":  "resourceFilename == metadata.json",
                                                                   "group":  "navigation"
                                                               },
                                                               {
                                                                   "command":  "realm.openRmesh3D",
                                                                   "when":  "resourceExtname == .rmesh",
                                                                   "group":  "navigation"
                                                               },
                                                               {
                                                                   "command":  "realm.exportRanim",
                                                                   "when":  "resourceExtname == .ranim",
                                                                   "group":  "navigation"
                                                               }
                                                           ]
                                  },
                        "jsonValidation":  [
                                               {
                                                   "fileMatch":  "**/metadata.json",
                                                   "url":  "./metadata.schema.json"
                                               },
                                               {
                                                   "fileMatch":  "**/manifest.json",
                                                   "url":  "./manifest.schema.json"
                                               },
                                               {
                                                   "fileMatch":  "**/terrain.json",
                                                   "url":  "./terrain.schema.json"
                                               }
                                           ],
                        "configuration":  {
                                              "title":  "Realm Map Authoring",
                                              "properties":  {
                                                                 "realm.mapAuthoring.hover":  {
                                                                                                  "type":  "boolean",
                                                                                                  "default":  true,
                                                                                                  "description":  "Explain schema-driven values in map documents when the pointer rests on them."
                                                                                              },
                                                                 "realm.mapAuthoring.decorations":  {
                                                                                                        "type":  "boolean",
                                                                                                        "default":  true,
                                                                                                        "description":  "Draw inline colour swatches and asset kind glyphs in map documents."
                                                                                                    },
                                                                 "realm.mapAuthoring.codeLens":  {
                                                                                                     "type":  "boolean",
                                                                                                     "default":  true,
                                                                                                     "description":  "Offer preview lenses above asset and colour values in map documents."
                                                                                                 }
                                                             }
                                          }
                    },
    "dependencies":  {
                         "jsonc-parser":  "^3.3.1"
                     },
    "scripts":  {
                    "vscode:prepublish":  "npm run compile",
                    "compile":  "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --main-fields=module,main \u0026\u0026 esbuild src/authoringForm/webview/main.ts --bundle --outfile=dist/form.js --platform=browser --format=iife",
                    "watch":  "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --main-fields=module,main --watch"
                },
    "devDependencies":  {
                            "@types/node":  "^20.19.43",
                            "@types/vscode":  "^1.75.0",
                            "esbuild":  "^0.20.0",
                            "typescript":  "^5.0.0"
                        }
}