<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="GenerateSchemas" BeforeTargets="NpmBuild;Build;SyncToEmbedded" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/generate-schemas.ps1&quot;" />
  </Target>

  <Target Name="SyncVersion" BeforeTargets="NpmBuild" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/sync-version.ps1&quot;" ContinueOnError="true" />
  </Target>

  <Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('node_modules')">
    <Exec Command="npm install" />
  </Target>

  <Target Name="NpmBuild" AfterTargets="NpmInstall" BeforeTargets="Build">
    <Exec Command="npm run compile" />
  </Target>

  <Target Name="SyncToEmbedded" AfterTargets="Build">
    <ItemGroup>
      <DistFiles Include="dist\**\*.*" />
      <MediaFiles Include="media\**\*.*" />
      <RootFiles Include="package.json;metadata.schema.json;terrain.schema.json;manifest.schema.json" />
    </ItemGroup>

    <Copy SourceFiles="@(DistFiles)" DestinationFiles="@(DistFiles->'$(MSBuildProjectDirectory)/../Realm.Godot/vscode_extensions_dist/speige.realm-map-editor/dist/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(MediaFiles)" DestinationFiles="@(MediaFiles->'$(MSBuildProjectDirectory)/../Realm.Godot/vscode_extensions_dist/speige.realm-map-editor/media/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(RootFiles)" DestinationFiles="@(RootFiles->'$(MSBuildProjectDirectory)/../Realm.Godot/vscode_extensions_dist/speige.realm-map-editor/%(Filename)%(Extension)')" />
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../scripts/sync-version_visualStudio_debug.ps1&quot;" ContinueOnError="true" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <Target Name="CopyToMapTemplate" AfterTargets="SyncToEmbedded">
    <PropertyGroup>
      <MapTemplateVsCodeDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)\..\MapTemplate\.vscode'))</MapTemplateVsCodeDir>
    </PropertyGroup>
    <MakeDir Directories="$(MapTemplateVsCodeDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\metadata.schema.json" DestinationFolder="$(MapTemplateVsCodeDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\terrain.schema.json"  DestinationFolder="$(MapTemplateVsCodeDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\manifest.schema.json" DestinationFolder="$(MapTemplateVsCodeDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
