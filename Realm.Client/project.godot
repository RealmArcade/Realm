config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Realm"
run/main_scene="uid://btcnvnkjpuns1"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"

[autoload]

LobbyManager="*res://Network/LobbyManager.cs"

[debug]

canvas_items/debug_run_bar=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
physics/common/physics_ticks_per_second=30

[dotnet]

project/assembly_name="Realm.Client"

