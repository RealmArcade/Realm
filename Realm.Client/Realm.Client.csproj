<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8981</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);vscode_embedded\**;wasi_sdk_embedded\**;.vscode\**;.godot\**;Maps\**\obj\**;Maps\**\bin\**;MapTemplate\**\obj\**;MapTemplate\**\bin\**</DefaultItemExcludes>

  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Realm.Shared\Realm.Shared.csproj" />
    <ProjectReference Include="..\Realm.Ecs\Realm.Ecs.csproj" />
    <ProjectReference Include="..\Realm.EditorAPI\Realm.EditorAPI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="vscode_embedded\**" />
    <Compile Remove="wasi_sdk_embedded\**" />
    <Compile Remove=".vscode\**" />
    <Compile Remove="Maps\**\obj\**" />
    <Compile Remove="Maps\**\bin\**" />
    <Compile Remove="Maps\**\*.cs" />
    <Compile Remove="Maps\Test final\**\*.cs" />
    <Compile Remove="Maps\Prueba torre\**\*.cs" />
    <Compile Remove="Maps\blank_map\**\*.cs" />
    <Compile Remove="MapTemplate\**\*.cs" />
    <Compile Remove=".godot\**" />
    <None Remove="vscode_embedded\**" />
    <None Remove="wasi_sdk_embedded\**" />
    <None Remove=".vscode\**" />
    <None Remove="Maps\**\obj\**" />
    <None Remove="Maps\**\bin\**" />
    <None Remove="Maps\**\*.cs" />
    <None Remove="Maps\Test final\**\*.cs" />
    <None Remove="Maps\Prueba torre\**\*.cs" />
    <None Remove="Maps\blank_map\**\*.cs" />
    <None Remove="MapTemplate\**\*.cs" />
    <None Remove=".godot\**" />
    <None Include="install_editor_dependencies.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ThirdPartyBinaries\steam_api64.dll" Condition="Exists('..\ThirdPartyBinaries\steam_api64.dll')">
      <Link>steam_api64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="vscode_extensions_dist\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MapTemplate\**\*.*" Exclude="..\MapTemplate\bin\**;..\MapTemplate\obj\**">
      <Link>MapTemplate\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\ThirdPartyBinaries\**\*.*">
      <Link>ThirdPartyBinaries\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Realm.MapEditorExtension\metadata.schema.json">
      <Link>Realm.MapEditorExtension\metadata.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Realm.MapEditorExtension\terrain.schema.json">
      <Link>Realm.MapEditorExtension\terrain.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Realm.MapEditorExtension\manifest.schema.json">
      <Link>Realm.MapEditorExtension\manifest.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Realm.MapAPI\wit\game.g.wit">
      <Link>Realm.MapAPI\wit\game.g.wit</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Templates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Realm.Client.Tests\*.cs" Link="Tests\%(Filename)%(Extension)" />
    <Compile Include="..\Realm.Client.Tests\gdunit4_testadapter_v5\GdUnit4TestRunnerScene.cs" Link="gdunit4_testadapter_v5\GdUnit4TestRunnerScene.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Blake3" Version="2.2.1" />
    <PackageReference Include="Fastenshtein" Version="1.0.12" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="SharpToken" Version="2.0.6" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" GeneratePathProperty="true" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- The authority is a process of its own and nothing is linked against it: it is built here so a development run
         always has one, and it is exported separately into the folder ListenServerTarget names. -->
    <ProjectReference Include="..\Realm.ListenServerHost\Realm.ListenServerHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="GenerateEnglishLocalization" BeforeTargets="CoreCompile;AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\Realm.LocalizationGenerator\Realm.LocalizationGenerator.csproj&quot; -- &quot;$(MSBuildThisFileDirectory)..\Realm.slnx&quot; &quot;$(MSBuildThisFileDirectory)locale\en.json&quot;" />
  </Target>
  <ItemGroup>
    <AdditionalFiles Include="..\Realm.MapAPI\wit\game.wit" />
  </ItemGroup>
  <Target Name="PlaceSteamworksManagedLibrary" AfterTargets="Build">
    <!-- The package carries Steamworks.NET only under runtimes/, and an exported Godot build gathers assemblies flat. -->
    <Copy SourceFiles="$(PkgSteamworks_NET)\runtimes\win-x64\lib\netstandard2.1\Steamworks.NET.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>