    [Realm.Client.Core.DomainLogic]
    public void SetAbilityManaCost(Realm.MapAPI.IUnit unit, string abilityId, float manaCost)
    {
        if (string.IsNullOrEmpty(abilityId)) return;

        if (!AbilityDefinitions.TryGetValue(abilityId, out var def))
        {
            def = new Realm.Client.Core.AbilityDefinition { Id = abilityId };
            AbilityDefinitions[abilityId] = def;
        }

        def.ManaCost = manaCost;
        if (unit != null)
        {
            UnitAbilityManaCosts[(unit.UniqueId, abilityId)] = manaCost;
        }
    }

    
    [Realm.Client.Core.DomainLogic]
    public void SaveUnitObjectAttachment(string unitId, Realm.Shared.Animation.HumanoidBone hand, string attachmentId, Realm.Shared.Metadata.HandAttachmentOrientation orientation, string wsPath)
    {
        string handKey = hand switch
        {
            Realm.Shared.Animation.HumanoidBone.LeftHand => "left_hand",
            Realm.Shared.Animation.HumanoidBone.RightHand => "right_hand",
            Realm.Shared.Animation.HumanoidBone.Chest => "chest",
            Realm.Shared.Animation.HumanoidBone.Hips => "root",
            Realm.Shared.Animation.HumanoidBone.Head => "head",
            Realm.Shared.Animation.HumanoidBone.LeftFoot => "left_foot",
            Realm.Shared.Animation.HumanoidBone.RightFoot => "right_foot",
            _ => "right_hand"
        };
        SaveUnitObjectAttachment(unitId, handKey, attachmentId, orientation, wsPath);
    }

    
    [Realm.Client.Core.DomainLogic]
    public void SaveUnitObjectAttachment(string unitId, string socket, string attachmentId, Realm.Shared.Metadata.HandAttachmentOrientation orientation, string wsPath = null)
    {
        if (string.IsNullOrEmpty(unitId) || string.IsNullOrEmpty(attachmentId)) return;

        var (regKey, isBuildingMeta) = ResolveRegistryKeyAndType(unitId);

        UpdateLocalRegistry(regKey, isBuildingMeta, socket, attachmentId, orientation);

        UpdateMetadataFile(unitId, regKey, socket, attachmentId, orientation, wsPath);

        ApplyAttachmentsToGameInstances(unitId, regKey);
    }

    
    [Realm.Client.Core.DomainLogic]
    public (string regKey, bool isBuildingMeta) ResolveRegistryKeyAndType(string unitId)
    {
        string regKey = unitId;
        bool isBuildingMeta = false;

        if (Realm.Client.Core.GameHost.UnitRegistry.ContainsKey(unitId)) return (regKey, isBuildingMeta);
        if (Realm.Client.Core.GameHost.BuildingRegistry != null && Realm.Client.Core.GameHost.BuildingRegistry.ContainsKey(unitId)) return (regKey, true);

        string cleanId = System.IO.Path.GetFileNameWithoutExtension(unitId);
        if (Realm.Client.Core.GameHost.UnitRegistry.ContainsKey(cleanId)) return (cleanId, false);
        if (Realm.Client.Core.GameHost.BuildingRegistry != null && Realm.Client.Core.GameHost.BuildingRegistry.ContainsKey(cleanId)) return (cleanId, true);

        return ResolveRegistryKeyByIterating(unitId, cleanId);
    }

    
    [Realm.Client.Core.DomainLogic]
    public (string regKey, bool isBuildingMeta) ResolveRegistryKeyByIterating(string unitId, string cleanId)
    {
        string regKey = unitId;
        bool isBuildingMeta = false;

        foreach (var k in Realm.Client.Core.GameHost.UnitRegistry.Keys)
        {
            string kStr = k.ToString();
            if (kStr.Equals(unitId, StringComparison.OrdinalIgnoreCase) ||
                kStr.Equals(cleanId, StringComparison.OrdinalIgnoreCase) ||
                System.IO.Path.GetFileNameWithoutExtension(kStr).Equals(cleanId, StringComparison.OrdinalIgnoreCase))
            {
                return (k.ToString(), false);
            }
        }

        if (Realm.Client.Core.GameHost.BuildingRegistry != null)
        {
            foreach (var k in Realm.Client.Core.GameHost.BuildingRegistry.Keys)
            {
                string kStr = k.ToString();
                if (kStr.Equals(unitId, StringComparison.OrdinalIgnoreCase) ||
                    kStr.Equals(cleanId, StringComparison.OrdinalIgnoreCase) ||
                    System.IO.Path.GetFileNameWithoutExtension(kStr).Equals(cleanId, StringComparison.OrdinalIgnoreCase))
                {
                    return (k.ToString(), true);
                }
            }
        }

        return (regKey, isBuildingMeta);
    }

    
    [Realm.Client.Core.DomainLogic]
    public void UpdateLocalRegistry(string regKey, bool isBuildingMeta, string socket, string attachmentId, Realm.Shared.Metadata.HandAttachmentOrientation orientation)
    {
        if (isBuildingMeta && Realm.Client.Core.GameHost.BuildingRegistry != null && Realm.Client.Core.GameHost.BuildingRegistry.TryGetValue(regKey, out var bMeta))
        {
            bMeta.SetObjectAttachment(socket, attachmentId, orientation);
            Realm.Client.Core.GameHost.BuildingRegistry[regKey] = bMeta;
        }
        else if (Realm.Client.Core.GameHost.UnitRegistry.TryGetValue(regKey, out var uMeta))
        {
            uMeta.SetObjectAttachment(socket, attachmentId, orientation);
            Realm.Client.Core.GameHost.UnitRegistry[regKey] = uMeta;
        }
    }

    
    [Realm.Client.Core.DomainLogic]
    public void UpdateMetadataFile(string unitId, string regKey, string socket, string attachmentId, Realm.Shared.Metadata.HandAttachmentOrientation orientation, string wsPath = null)
    {
        string metadataPath = MetadataService.ResolveMetadataPath(wsPath);
        if (!System.IO.File.Exists(metadataPath)) return;

        MetadataService.Instance.UpdateMetadata(wsPath, meta =>
        {
            bool updated = meta.UpdateUnit(unitId, u => { u.SetObjectAttachment(socket, attachmentId, orientation); return u; });
            if (!updated) updated = meta.UpdateBuilding(unitId, b => { b.SetObjectAttachment(socket, attachmentId, orientation); return b; });
            if (!updated) updated = meta.UpdateUnit(regKey, u => { u.SetObjectAttachment(socket, attachmentId, orientation); return u; });
            if (!updated) meta.UpdateBuilding(regKey, b => { b.SetObjectAttachment(socket, attachmentId, orientation); return b; });
        });
        
        // Use GameHost to resolve WorldAccessor or just skip it if it's tricky? Wait, ServiceLocator.Get<WorldAccessor>() is valid.
        Realm.Client.Services.ServiceLocator.Get<Realm.Ecs.Services.WorldAccessor>()._lastMetadataSyncTime = GetLastWriteTimeSafe(metadataPath);
    }

    
    [Realm.Client.Core.DomainLogic]
    public void ApplyAttachmentsToGameInstances(string unitId, string regKey)
    {
        if (Realm.Client.Core.GameHost.Instance == null) return;

        if (Realm.Client.Core.GameHost.Instance.AllUnits != null)
        {
            foreach (var u in Realm.Client.Core.GameHost.Instance.AllUnits)
            {
                if (u != null && IsMatchingUnit(u.UnitId, unitId, regKey))
                {
                    u.ApplyAllConfiguredAttachments();
                }
            }
        }

        if (Realm.Client.Core.GameHost.Instance.SelectedEditorObject is Realm.Client.Unit3D selUnit)
        {
            if (IsMatchingUnit(selUnit.UnitId, unitId, regKey))
            {
                selUnit.ApplyAllConfiguredAttachments();
            }
        }
    }

    
    [Realm.Client.Core.DomainLogic]
    public bool IsMatchingUnit(string instanceUnitId, string unitId, string regKey)
    {
        return instanceUnitId == unitId ||
               instanceUnitId == regKey ||
               System.IO.Path.GetFileNameWithoutExtension(instanceUnitId ?? "").Equals(System.IO.Path.GetFileNameWithoutExtension(unitId), System.StringComparison.OrdinalIgnoreCase);
    }

    
    [Realm.Client.Core.DomainLogic]
    public void SaveAllUnitObjectAttachments(string targetId, Realm.Shared.Metadata.UnitObjectAttachments? attachments, System.Action<string, Realm.Shared.Metadata.UnitObjectAttachments?> restoreCallback)
    {
        restoreCallback?.Invoke(targetId, attachments);
    }

    
    [Realm.Client.Core.DomainLogic]
    public void SaveCustomWeaponToMetadata(string weaponId, Realm.Shared.Metadata.WeaponMetadata weapon, string wsPath)
    {
        string metadataPath = MetadataService.ResolveMetadataPath(wsPath);
        if (!System.IO.File.Exists(metadataPath)) return;

        MetadataService.Instance.UpdateMetadata(wsPath, meta =>
        {
            meta.AddOrUpdateWeapon(weapon);
        });
        Realm.Client.Services.ServiceLocator.Get<Realm.Ecs.Services.WorldAccessor>()._lastMetadataSyncTime = GetLastWriteTimeSafe(metadataPath);
    }

    
    private long GetLastWriteTimeSafe(string path)
    {
        if (!System.IO.File.Exists(path)) return 0;
        return System.IO.File.GetLastWriteTimeUtc(path).Ticks;
    }

    
    [Realm.Client.Core.DomainLogic]
    public async System.Threading.Tasks.Task<(bool success, string errorMessage)> RegisterCreatorAsync(string username, string pubKeyStr, NSec.Cryptography.Key key, string seedServerUrl, string keyDir)
    {
        byte[] payloadBytes = System.Text.Encoding.UTF8.GetBytes(username + ":" + pubKeyStr);
        byte[] sigBytes = NSec.Cryptography.SignatureAlgorithm.Ed25519.Sign(key, payloadBytes);
        string signatureStr = System.Convert.ToBase64String(sigBytes);

        var regPayload = new { Username = username, PublicKey = pubKeyStr, Signature = signatureStr };
        
        using var httpClient = new System.Net.Http.HttpClient { Timeout = System.TimeSpan.FromSeconds(5) };
        var content = new System.Net.Http.StringContent(System.Text.Json.JsonSerializer.Serialize(regPayload), System.Text.Encoding.UTF8, "application/json");
        var res = await httpClient.PostAsync(seedServerUrl + "/api/creators/register", content);

        if (res.IsSuccessStatusCode)
        {
            Realm.Shared.Distribution.AuthorshipKeyHelper.UpdateUserName(keyDir, username);
            return (true, null);
        }
        else
        {
            string errText = await res.Content.ReadAsStringAsync();
            try
            {
                var errDoc = System.Text.Json.JsonDocument.Parse(errText);
                if (errDoc.RootElement.TryGetProperty("Message", out var msgProp))
                {
                    return (false, msgProp.GetString());
                }
                else
                {
                    return (false, Godot.TranslationServer.Translate("Registration failed."));
                }
            }
            catch
            {
                return (false, Godot.TranslationServer.Translate("Registration failed: ") + errText);
            }
        }
    }

    public void ClearAll()
    {
        UnitRegistry.Clear();
        BuildingRegistry.Clear();
        PropRegistry.Clear();
        ResourceRegistry.Clear();
        WeaponRegistry.Clear();
        AttachmentRegistry.Clear();
        ItemRegistry.Clear();
        VfxRegistry.Clear();
        AbilityDefinitions.Clear();
        UnitAbilityStates.Clear();
        UnitAbilityManaCosts.Clear();
        ItemTooltips.Clear();
    }
}
