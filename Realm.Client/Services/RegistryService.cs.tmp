    [Realm.Client.Core.DomainLogic]
    public void SetAbilityState(Realm.MapAPI.IUnit unit, string abilityId, bool disabled, bool hidden)
    {
        if (unit == null || string.IsNullOrEmpty(abilityId)) return;
        UnitAbilityStates[(unit.UniqueId, abilityId)] = (disabled, hidden);
    }

    [Realm.Client.Core.DomainLogic]
    public bool IsAbilityDisabledForUnit(Realm.MapAPI.IUnit unit, string abilityId)
    {
        if (unit != null && UnitAbilityStates.TryGetValue((unit.UniqueId, abilityId), out var state))
        {
            return state.Disabled;
        }
        return false;
    }

