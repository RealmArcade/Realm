{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapUnitsRegistry",
  "type": "object",
  "properties": {
    "GameBuildNumber": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "MapProperties": {
      "type": "object",
      "properties": {
        "MapName": {
          "type": "string"
        },
        "MapDescription": {
          "type": "string"
        },
        "SuggestedPlayers": {
          "type": "string"
        },
        "MinimapImage": {
          "type": "string"
        },
        "ShroudType": {
          "type": "string",
          "enum": ["visible", "VisionShroud", "ExplorationShroud", "grey", "black"]
        },
        "TerrainBaseHeight": {
          "type": "number",
          "minimum": 0
        },
        "ShadowIntensity": {
          "type": "number",
          "minimum": 0
        },
        "MapWidth": {
          "type": "integer",
          "minimum": 0
        },
        "CameraBoundsLeft": {
          "type": "number"
        },
        "CameraBoundsRight": {
          "type": "number"
        },
        "CameraBoundsTop": {
          "type": "number"
        },
        "CameraBoundsBottom": {
          "type": "number"
        },
        "MapHeight": {
          "type": "integer",
          "minimum": 0
        },
        "PlayableWidth": {
          "type": "integer",
          "minimum": 0
        },
        "PlayableHeight": {
          "type": "integer",
          "minimum": 0
        },
        "LoadingImage": {
          "type": "string"
        },
        "LoadingMusic": {
          "type": "string"
        },
        "LoadingTitle": {
          "type": "string"
        },
        "LoadingSubtitle": {
          "type": "string"
        },
        "LoadingBodyText": {
          "type": "string"
        },
        "HowToPlayInstructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "HowToPlayObjective": {
          "type": "string"
        },
        "Version": {
          "type": "string"
        },
        "Changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["Version", "Date", "Details"],
            "properties": {
              "Version": { "type": "string" },
              "Date": { "type": "string" },
              "Details": { "type": "string" }
            }
          }
        },
        "PlayerSlots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["SlotId", "Name", "Color", "Faction", "Controller"],
            "properties": {
              "SlotId": { "type": "integer", "minimum": 0 },
              "Name": { "type": "string" },
              "Color": { "type": "string" },
              "Faction": { "type": "string" },
              "Controller": { "type": "string", "enum": ["HumanPlayer", "ComputerAi", "Neutral", "Hostile", "Open", "Closed"] },
              "AiType": { "type": "string" },
              "StartLocation": { "type": "string" },
              "CustomDecal": { "type": "string" }
            }
          }
        },
        "Teams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["TeamName", "Slots"],
            "properties": {
              "TeamName": { "type": "string" },
              "Slots": {
                "type": "array",
                "items": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "CustomUnits": {
      "type": "array",
      "items": { "$ref": "#/definitions/EntityItem" }
    },
    "CustomBuildings": {
      "type": "array",
      "items": { "$ref": "#/definitions/EntityItem" }
    },
    "CustomResources": {
      "type": "array",
      "items": { "$ref": "#/definitions/EntityItem" }
    },
    "CustomProps": {
      "type": "array",
      "items": { "$ref": "#/definitions/EntityItem" }
    },
    "CustomAbilities": { "$ref": "#/definitions/CustomAbilities" },
    "CustomWeapons": { "$ref": "#/definitions/CustomWeapons" },
    "CustomUpgrades": { "$ref": "#/definitions/CustomUpgrades" },
    "CustomItems": { "$ref": "#/definitions/CustomItems" },
    "Assets": { "$ref": "#/definitions/Assets" },
    "textures": { "type": "object" }
  },
  "definitions": {
    "EntityItem": {
      "type": "object",
      "required": [
        "UnitId",
        "Name",
        "Description"
      ],
        "properties": {
          "UnitId": { "type": "string" },
          "Name": { "type": "string" },
          "Description": { "type": "string" },
          "MaxHp": { "type": "number", "minimum": 0 },
          "Damage": { "type": "number", "minimum": 0 },
          "Range": { "type": "number", "minimum": 0 },
          "Armor": { "type": "number", "minimum": 0 },
          "Speed": { "type": "number", "minimum": 0 },
          "AttackCooldown": { "type": "number", "minimum": 0 },
          "ScanRadius": { "type": "number", "minimum": 0 },
          "CostGold": { "type": "number", "minimum": 0 },
          "CostWood": { "type": "number", "minimum": 0 },
          "CostStone": { "type": "number", "minimum": 0 },
          "ProductionTime": { "type": "number", "minimum": 0 },
          "PopCost": { "type": "integer", "minimum": 0 },
          "AttackType": { "type": "string", "enum": ["melee", "ranged", "none"] },
          "ArmorType": { "type": "string", "enum": ["light", "heavy", "building"] },
          "GoldBounty": { "type": "number", "minimum": 0 },
          "ModelPath": { "type": "string" },
          "Scale": { "type": "number", "minimum": 0 },
          "YOffset": { "type": "number" },
          "CollisionCircle": { "type": "number", "minimum": 0 },
          "Brightness": { "type": "number", "minimum": 0 },
          "Tint": { "type": "string" },
          "DespillPlayerColor": { "type": "boolean" },
          "NormalizeLuminance": { "type": "boolean" },
          "IgnorePlayerColor": { "type": "boolean" },
          "MaxCapacity": { "type": "number", "minimum": 0 },
          "HarvestRate": { "type": "number", "minimum": 0 },
          "GrowthRate": { "type": "number", "minimum": 0 },
          "MaxWorkers": { "type": "integer", "minimum": 1 },
          "BuildOptions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "IsHero": { "type": "boolean" },
          "Abilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "XpBounty": { "type": "number", "minimum": 0 },
          "Weapons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "StartingItems": {
            "type": "array",
            "items": { "type": "string" }
          },
          "Upgrades": {
            "type": "array",
            "items": { "type": "string" }
          },
          "PathingType": {
            "type": "integer",
            "description": "Bitmask flags (1=ShallowWater, 2=DeepWater, 4=Flying, 8=Ground, 32=Buildable, 255=All)"
          },
          "StatusEffects": {
            "type": "array",
            "items": { "type": "string" }
          },
          "SoundEvents": {
            "type": "array",
            "items": { "type": "string" }
          },
          "PortraitModelPath": { "type": "string" },
          "Animations": {
            "type": "object",
            "description": "Dictionary of animation type enum to array of animation file names or attachment objects",
            "properties": {
              "Idle": { "$ref": "#/definitions/AnimationList" },
              "Walk": { "$ref": "#/definitions/AnimationList" },
              "Attack": { "$ref": "#/definitions/AnimationList" },
              "Death": { "$ref": "#/definitions/AnimationList" },
              "Labor": { "$ref": "#/definitions/AnimationList" },
              "Spell_Cast": { "$ref": "#/definitions/AnimationList" },
              "Dance": { "$ref": "#/definitions/AnimationList" }
            },
            "additionalProperties": {
              "$ref": "#/definitions/AnimationList"
            }
          },
          "ObjectAttachments": {
            "type": "object",
            "properties": {
              "right_hand": {
                "type": "array",
                "items": { "type": "object" }
              },
              "left_hand": {
                "type": "array",
                "items": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "AnimationList": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["Animation"],
            "properties": {
              "Animation": { "type": "string" },
              "RightHandAttachment": { "type": ["string", "null"] },
              "LeftHandAttachment": { "type": ["string", "null"] }
            }
          }
        ]
      }
    },
    "CustomAbilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["AbilityId", "Name", "Description", "AbilityType"],
        "properties": {
          "AbilityId": { "type": "string" },
          "Name": { "type": "string" },
          "Description": { "type": "string" },
          "AbilityType": { "type": "string", "enum": ["target_spell", "instant_spell", "passive"] },
          "ManaCost": { "type": "number", "minimum": 0 },
          "Cooldown": { "type": "number", "minimum": 0 },
          "TargetRange": { "type": "number", "minimum": 0 },
          "VisualEffect": { "type": "string" },
          "CastSound": { "type": "string" },
          "IconPath": { "type": "string" },
          "AppliedStatusEffects": {
            "type": "array",
            "items": { "type": "string" }
          },
          "AreaOfEffectRadius": { "type": "number", "minimum": 0 },
          "Damage": { "type": "number", "minimum": 0 },
          "Healing": { "type": "number", "minimum": 0 },
          "SummonedUnitId": { "type": "string" },
          "SummonCount": { "type": "integer", "minimum": 1 },
          "SummonDuration": { "type": "number", "minimum": 0 }
        }
      }
    },
    "CustomUpgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["UpgradeId", "Name", "Description"],
        "properties": {
          "UpgradeId": { "type": "string" },
          "Name": { "type": "string" },
          "Description": { "type": "string" },
          "CostGold": { "type": "number", "minimum": 0 },
          "CostWood": { "type": "number", "minimum": 0 },
          "CostStone": { "type": "number", "minimum": 0 },
          "ResearchTime": { "type": "number", "minimum": 0 },
          "Requirement": { "type": "string" },
          "MaxLevel": { "type": "integer", "minimum": 1 },
          "AffectedUnitIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "MaxHpBonus": { "type": "number" },
          "DamageBonus": { "type": "number" },
          "ArmorBonus": { "type": "number" },
          "SpeedBonus": { "type": "number" }
        }
      }
    },
    "CustomItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ItemId", "Name", "Description", "ItemClass"],
        "properties": {
          "ItemId": { "type": "string" },
          "Name": { "type": "string" },
          "Description": { "type": "string" },
          "ItemClass": { "type": "string", "enum": ["consumable", "equipment", "quest"] },
          "CostGold": { "type": "number", "minimum": 0 },
          "UseAbility": { "type": "string" },
          "ChargeCount": { "type": "integer", "minimum": 0 },
          "CooldownLink": { "type": "string" },
          "CanDrop": { "type": "boolean" },
          "ItemLevel": { "type": "integer", "minimum": 0 },
          "IconPath": { "type": "string" },
          "PassiveStatusEffects": {
            "type": "array",
            "items": { "type": "string" }
          },
          "GrantedWeapons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "IsContainer": { "type": "boolean" },
          "ContainerSize": { "type": "integer", "minimum": 0 },
          "Requirements": { "type": "string" }
        }
      }
    },
    "CustomWeapons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["WeaponId", "Name", "Damage", "Range", "AttackCooldown", "AttackType"],
        "properties": {
          "WeaponId": { "type": "string" },
          "Name": { "type": "string" },
          "Damage": { "type": "number", "minimum": 0 },
          "Range": { "type": "number", "minimum": 0 },
          "AttackCooldown": { "type": "number", "minimum": 0 },
          "AttackType": { "type": "string", "enum": ["melee", "ranged", "none"] },
          "ProjectileSpeed": { "type": "number", "minimum": 0 },
          "VisualEffect": { "type": "string" },
          "AttackSound": { "type": "string" },
          "ProjectileModelPath": { "type": "string" },
          "ImpactVisualEffect": { "type": "string" },
          "ImpactSound": { "type": "string" },
          "ArcHeight": { "type": "number" },
          "HomingWeight": { "type": "number", "minimum": 0, "maximum": 1 },
          "EaseCurve": { "type": "string", "enum": ["linear", "ease_in", "ease_out", "ease_in_out"] },
          "TumbleAngularVelocity": {
            "type": "object",
            "properties": {
              "X": { "type": "number" },
              "Y": { "type": "number" },
              "Z": { "type": "number" }
            }
          },
          "OrientToTrajectory": { "type": "boolean" },
          "SpiralRadius": { "type": "number" },
          "SpiralFrequency": { "type": "number" },
          "ZigzagAmplitude": { "type": "number" },
          "ZigzagFrequency": { "type": "number" },
          "MaxBounces": { "type": "integer", "minimum": 0 },
          "PierceCount": { "type": "integer", "minimum": 0 },
          "TurnRateLimit": { "type": "number", "minimum": 0 },
          "SpeedCurve": { "type": "string", "enum": ["constant", "ease_in", "ease_out", "ease_in_out", "rocket_boost", "burst", "accelerate", "decelerate"] },
          "Acceleration": { "type": "number" },
          "MaxLifetime": { "type": "number", "minimum": 0 },
          "FailsafeRange": { "type": "number", "minimum": 0 },
          "ScaleCurve": { "type": "string", "enum": ["constant", "grow", "shrink", "grow_shrink", "squash_stretch", "impact_shrink"] },
          "ForwardAxisPreset": { "type": "string", "enum": ["-Z", "+Z", "+X", "-X", "+Y", "-Y"] },
          "MeshRotationOffset": {
            "type": "object",
            "properties": {
              "X": { "type": "number" },
              "Y": { "type": "number" },
              "Z": { "type": "number" }
            }
          },
          "MeshTranslationOffset": {
            "type": "object",
            "properties": {
              "X": { "type": "number" },
              "Y": { "type": "number" },
              "Z": { "type": "number" }
            }
          },
          "MeshScaleOffset": {
            "type": "object",
            "properties": {
              "X": { "type": "number" },
              "Y": { "type": "number" },
              "Z": { "type": "number" }
            }
          },
          "ShaderEffectType": { "type": "string" },
          "EmissionMaskSource": { "type": "string", "enum": ["noise", "vertex_color", "fresnel", "texture_alpha"] },
          "BaseColor": { "type": "string" },
          "EmissionColor": { "type": "string" },
          "EmissionEnergy": { "type": "number" },
          "FresnelPower": { "type": "number" },
          "FresnelColor": { "type": "string" },
          "FresnelFactor": { "type": "number" },
          "NoiseScale": { "type": "number" },
          "NoiseTexture": { "type": "string" },
          "UvScrollSpeed1": {
            "type": "object",
            "properties": {
              "X": { "type": "number" },
              "Y": { "type": "number" }
            }
          },
          "UvScrollSpeed2": {
            "type": "object",
            "properties": {
              "X": { "type": "number" },
              "Y": { "type": "number" }
            }
          },
          "ThresholdCutoff": { "type": "number" },
          "ThresholdSmoothness": { "type": "number" },
          "PointLightEnabled": { "type": "boolean" },
          "PointLightColor": { "type": "string" },
          "PointLightIntensity": { "type": "number", "minimum": 0 },
          "PointLightRange": { "type": "number", "minimum": 0 },
          "RibbonTexture": { "type": "string" },
          "RibbonColor": { "type": "string" },
          "RibbonWidth": { "type": "number" },
          "RibbonLifetime": { "type": "number" },
          "RibbonTaper": { "type": "boolean" },
          "RibbonAdditive": { "type": "boolean" },
          "RibbonScrollSpeed": { "type": "number" },
          "TrailOffset": {
            "type": "object",
            "properties": {
              "X": { "type": "number" },
              "Y": { "type": "number" },
              "Z": { "type": "number" }
            }
          }
        }
      }
    },
    "Assets": {
      "type": "object"
    },
    "Models": { "type": "object" }
  }
}
