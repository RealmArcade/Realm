{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Re-generate Map API",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-Command",
				"dotnet build '${workspaceFolder}/../../../Realm.MapAPI/Realm.MapAPI.csproj'; Copy-Item '${workspaceFolder}/../../../Realm.MapAPI/bin/Debug/net10.0/Realm.MapAPI.*' '${workspaceFolder}/lib/' -Force"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build"
			},
			"detail": "Compiles Realm.MapAPI and copies DLL, XML, and PDB to the local map lib folder."
		},
		{
			"label": "Build WASM Map Script (Debug)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"publish",
				"${workspaceFolder}/MapScript.csproj",
				"-c",
				"Debug",
				"-r",
				"wasi-wasm"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile",
			"detail": "Builds the WASM map script in Debug configuration with DWARF symbols retained."
		}
	]
}
