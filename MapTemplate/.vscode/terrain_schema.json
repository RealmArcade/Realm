{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapTerrain",
  "type": "object",
  "properties": {
    "Width": {
      "type": "integer",
      "minimum": 1
    },
    "Depth": {
      "type": "integer",
      "minimum": 1
    },
    "CameraBoundsLeft": {
      "type": "number"
    },
    "CameraBoundsRight": {
      "type": "number"
    },
    "CameraBoundsTop": {
      "type": "number"
    },
    "CameraBoundsBottom": {
      "type": "number"
    },
    "SkyboxPath": {
      "type": "string"
    },
    "Coordinates": {
      "type": "array",
      "items": { "$ref": "#/definitions/Coordinate" }
    },
    "Units": {
      "type": "array",
      "items": { "$ref": "#/definitions/PlacedEntity" }
    },
    "Props": {
      "type": "array",
      "items": { "$ref": "#/definitions/PlacedProp" }
    },
    "Decals": {
      "type": "array",
      "items": { "$ref": "#/definitions/PlacedDecal" }
    },
    "Vfx": {
      "type": "array",
      "items": { "$ref": "#/definitions/PlacedVfx" }
    }
  },
  "definitions": {
    "Vector3": {
      "type": "object",
      "required": ["X", "Y", "Z"],
      "properties": {
        "X": { "type": "number" },
        "Y": { "type": "number" },
        "Z": { "type": "number" }
      }
    },
    "Coordinate": {
      "type": "object",
      "required": ["Name", "Min", "Max"],
      "properties": {
        "Name": {
          "type": "string"
        },
        "Min": {
          "$ref": "#/definitions/Vector3"
        },
        "Max": {
          "$ref": "#/definitions/Vector3"
        }
      }
    },
    "PlacedEntity": {
      "type": "object",
      "required": ["UnitId", "Position", "PlayerSlot"],
      "properties": {
        "UnitId": {
          "type": "string"
        },
        "Position": { "$ref": "#/definitions/Vector3" },
        "RotationY": {
          "type": "number",
          "default": 0
        },
        "Scale": {
          "type": "number",
          "minimum": 0,
          "default": 1.0
        },
        "PlayerSlot": {
          "type": "integer",
          "minimum": 0,
        }
      }
    },
    "PlacedProp": {
      "type": "object",
      "required": ["PropId", "Position"],
      "properties": {
        "PropId": {
          "type": "string"
        },
        "Position": { "$ref": "#/definitions/Vector3" },
        "RotationY": {
          "type": "number",
          "default": 0
        },
        "Scale": {
          "type": "number",
          "minimum": 0,
          "default": 1.0
        }
      }
    },
    "PlacedDecal": {
      "type": "object",
      "required": ["DecalId", "Position"],
      "properties": {
        "DecalId": {
          "type": "string",
        },
        "Position": { "$ref": "#/definitions/Vector3" },
        "RotationY": {
          "type": "number",
          "default": 0
        },
        "Scale": {
          "type": "number",
          "minimum": 0,
          "default": 1.0
        },
        "Opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1.0
        }
      }
    },
    "PlacedVfx": {
      "type": "object",
      "required": ["VfxId", "Position"],
      "properties": {
        "VfxId": {
          "type": "string"
        },
        "Position": { "$ref": "#/definitions/Vector3" },
        "RotationY": {
          "type": "number",
          "default": 0
        },
        "Scale": {
          "type": "number",
          "minimum": 0,
          "default": 1.0
        }
      }
    }
  }
}
