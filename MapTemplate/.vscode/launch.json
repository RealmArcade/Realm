{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Attach to Realm Game Host",
			"type": "coreclr",
			"request": "attach",
			"processName": "Realm.Client"
		},
		{
			"name": "Debug WASM Map Script (Attach via CodeLLDB)",
			"type": "lldb",
			"request": "attach",
			"program": "${workspaceFolder}/bin/Debug/net10.0/wasi-wasm/publish/MapScript.wasm",
			"processName": "Realm.Client",
			"cwd": "${workspaceFolder}",
			"initCommands": [
				"settings set plugin.jit-loader.gdb.enable on"
			]
		},
		{
			"name": "Debug WASM Map Script (Attach via GDB)",
			"type": "cppdbg",
			"request": "attach",
			"program": "${workspaceFolder}/bin/Debug/net10.0/wasi-wasm/publish/MapScript.wasm",
			"processName": "Realm.Client.exe",
			"MIMode": "gdb",
			"miDebuggerPath": "gdb",
			"cwd": "${workspaceFolder}",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		}
	]
}
