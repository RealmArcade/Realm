{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Attach to Realm Authority (Map Script WASM)",
			"type": "lldb",
			"request": "attach",
			"program": "${workspaceFolder}/MapScript.jit.elf",
			"processCreateCommands": [
				"realm_attach"
			],
			"cwd": "${workspaceFolder}",
			"relativePathBase": "${workspaceFolder}",
			"sourceLanguages": [
				"csharp"
			],
			"breakpointMode": "file",
			"showDisassembly": "never",
			"expressions": "simple",
			"consoleMode": "evaluate",
			"initCommands": [
				"command script import \"${workspaceFolder}/realm_lldb.py\"",
				"settings set plugin.jit-loader.gdb.enable off",
				"settings set target.process.run-all-threads false",
				"settings set target.process.thread.step-out-avoid-nodebug true",
				"settings set target.process.thread.step-in-avoid-nodebug true",
				"settings set target.process.thread.step-avoid-regexp ^(__wasm|wasmtime|cabi_|[rR]hp|System\\.|System_|System_Private_CoreLib|S_P_CoreLib_|Internal\\.|GameClientWorld|Realm\\.Ecs\\.|Realm_Ecs_|Microsoft\\.|wasmImport|wasm_import|__import|dotnet_|mono_|wasi_|env\\.)"
			],
			"postAttachCommands": [
				"process handle SIGTRAP -s false -n false -p false",
				"realm_load_modules",
				"continue"
			],
			"postRunCommands": [
				"process handle SIGTRAP -s false -n false -p false",
				"realm_load_modules",
				"continue"
			],
			"env": {
				"_NO_DEBUG_HEAP": "1"
			}
		},
		{
			"name": "Debug WASM Map Script (Attach via GDB)",
			"type": "cppdbg",
			"request": "attach",
			"processId": "${command:pickProcess}",
			"MIMode": "gdb",
			"miDebuggerPath": "gdb",
			"cwd": "${workspaceFolder}",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "Attach to Realm Game Host (.NET Core)",
			"type": "coreclr",
			"request": "attach",
			"processId": "${command:pickProcess}"
		}
	]
}
