{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug WASM Map Script (Attach via CodeLLDB)",
			"type": "lldb",
			"request": "attach",
			"pid": "${command:pickProcess}",
			"cwd": "${workspaceFolder}",
			"initCommands": [
				"settings set plugin.jit-loader.gdb.enable on"
			]
		},
		{
			"name": "Debug WASM Map Script (Attach via GDB)",
			"type": "cppdbg",
			"request": "attach",
			"processId": "${command:pickProcess}",
			"MIMode": "gdb",
			"miDebuggerPath": "gdb",
			"cwd": "${workspaceFolder}",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "Attach to Realm Game Host (.NET Core)",
			"type": "coreclr",
			"request": "attach",
			"processId": "${command:pickProcess}"
		}
	]
}
