<Project>
  <Target Name="PrepareInputsForWasmBuild" DependsOnTargets="GenerateMapTemplates" />

  <Target Name="GenerateMapTemplates" BeforeTargets="BeforeBuild;BeforeRebuild;CoreCompile">
    <PropertyGroup>
      <_MetadataJsonPath>$(MSBuildProjectDirectory)\metadata.json</_MetadataJsonPath>
      <_GeneratedTemplatesPath>$(MSBuildProjectDirectory)\MapTemplates.g.cs</_GeneratedTemplatesPath>
    </PropertyGroup>
    <GenerateMapTemplatesTask MetadataPath="$(_MetadataJsonPath)" OutputPath="$(_GeneratedTemplatesPath)" Condition="Exists('$(_MetadataJsonPath)')" />
  </Target>

  <UsingTask TaskName="GenerateMapTemplatesTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <MetadataPath ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          if (!File.Exists(MetadataPath)) return true;

          if (File.Exists(OutputPath) && File.GetLastWriteTimeUtc(OutputPath) >= File.GetLastWriteTimeUtc(MetadataPath))
          {
              return true;
          }

          string content = File.ReadAllText(MetadataPath);

          string GetJsonObjectContent(string text, string keyName)
          {
              int keyIdx = text.IndexOf("\"" + keyName + "\"", StringComparison.OrdinalIgnoreCase);
              if (keyIdx < 0) return "";
              int braceStart = text.IndexOf('{', keyIdx);
              if (braceStart < 0) return "";
              int depth = 0;
              for (int i = braceStart; i < text.Length; i++)
              {
                  if (text[i] == '{') depth++;
                  else if (text[i] == '}')
                  {
                      depth--;
                      if (depth == 0) return text.Substring(braceStart, i - braceStart + 1);
                  }
              }
              return "";
          }

          string GetJsonArrayContent(string text, string keyName)
          {
              if (string.IsNullOrEmpty(text)) return "";
              int keyIdx = text.IndexOf("\"" + keyName + "\"", StringComparison.OrdinalIgnoreCase);
              if (keyIdx < 0) return "";
              int bracketStart = text.IndexOf('[', keyIdx);
              if (bracketStart < 0) return "";
              int depth = 0;
              for (int i = bracketStart; i < text.Length; i++)
              {
                  if (text[i] == '[') depth++;
                  else if (text[i] == ']')
                  {
                      depth--;
                      if (depth == 0) return text.Substring(bracketStart, i - bracketStart + 1);
                  }
              }
              return "";
          }

          List<string> ExtractPropertyValues(string arrayText, string propertyName)
          {
              var list = new List<string>();
              if (string.IsNullOrEmpty(arrayText)) return list;
              var matches = Regex.Matches(arrayText, "\"" + propertyName + "\"\\s*:\\s*\"([^\"]+)\"");
              foreach (Match m in matches)
              {
                  if (m.Groups.Count > 1 && !string.IsNullOrWhiteSpace(m.Groups[1].Value))
                  {
                      list.Add(m.Groups[1].Value.Trim());
                  }
              }
              return list;
          }

          string SanitizeIdentifier(string input)
          {
              if (string.IsNullOrWhiteSpace(input)) return "Template";
              string slug = input.Trim();
              int slashIdx = slug.LastIndexOf('/');
              if (slashIdx >= 0) slug = slug.Substring(slashIdx + 1);

              string[] parts = Regex.Split(slug, @"[^a-zA-Z0-9]+");
              var sb = new StringBuilder();
              foreach (var p in parts)
              {
                  if (string.IsNullOrEmpty(p)) continue;
                  sb.Append(char.ToUpperInvariant(p[0]));
                  if (p.Length > 1) sb.Append(p.Substring(1));
              }

              string ident = sb.ToString();
              if (string.IsNullOrEmpty(ident)) ident = "Template";
              if (char.IsDigit(ident[0])) ident = "_" + ident;

              return ident;
          }

          var sbOut = new StringBuilder();
          sbOut.AppendLine("// <auto-generated>");
          sbOut.AppendLine("// This code was generated by Realm MapTemplate Generator.");
          sbOut.AppendLine("// Changes to this file may cause incorrect behavior and will be lost if the code is regenerated.");
          sbOut.AppendLine("// </auto-generated>");
          sbOut.AppendLine();
          sbOut.AppendLine("#nullable enable");
          sbOut.AppendLine();
          sbOut.AppendLine("namespace Realm.Maps;");
          sbOut.AppendLine();

          void EmitClass(string className, List<string> items)
          {
              sbOut.AppendLine($"public static class {className}");
              sbOut.AppendLine("{");
              var usedIdents = new HashSet<string>(StringComparer.Ordinal);
              if (items != null)
              {
                  foreach (var rawItem in items)
                  {
                      if (string.IsNullOrWhiteSpace(rawItem)) continue;
                      string baseIdent = SanitizeIdentifier(rawItem);
                      string ident = baseIdent;
                      int suffix = 2;
                      while (usedIdents.Contains(ident))
                      {
                          ident = baseIdent + "_" + suffix;
                          suffix++;
                      }
                      usedIdents.Add(ident);
                      sbOut.AppendLine($"\tpublic const string {ident} = \"{rawItem}\";");
                  }
              }
              sbOut.AppendLine("}");
              sbOut.AppendLine();
          }

          string templatesBlock = GetJsonObjectContent(content, "Templates");

          EmitClass("UnitIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Units"), "TemplateID"));
          EmitClass("BuildingIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Buildings"), "TemplateID"));
          EmitClass("ResourceIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Resources"), "TemplateID"));
          EmitClass("PropIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Props"), "TemplateID"));
          EmitClass("AbilityIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Abilities"), "TemplateID"));
          EmitClass("WeaponIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Weapons"), "TemplateID"));
          EmitClass("UpgradeIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Upgrades"), "TemplateID"));
          EmitClass("ItemIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Items"), "TemplateID"));
          EmitClass("VfxIds", ExtractPropertyValues(GetJsonArrayContent(templatesBlock, "Vfx"), "VfxId"));
          EmitClass("WaterProfileIds", ExtractPropertyValues(GetJsonArrayContent(content, "CustomWaterProfiles"), "Id"));

          File.WriteAllText(OutputPath, sbOut.ToString());
          Log.LogMessage(MessageImportance.High, "Validated and refreshed MapTemplates.g.cs successfully.");
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="_InitializeWasiSdk" Condition="'$(_targetOS)' == 'wasi'">
    <Error Text="Wasi SDK not found, not compiling to WebAssembly. To enable WebAssembly compilation, install Wasi SDK and ensure the WASI_SDK_PATH environment variable points to the directory containing share/wasi-sysroot" Condition="'$(WASI_SDK_PATH)' == ''" />
    <PropertyGroup>
      <_NativeWasmSdkBinPath>$([MSBuild]::NormalizeDirectory('$(WASI_SDK_PATH)', 'bin'))</_NativeWasmSdkBinPath>
      <CppCompiler Condition="'$(CppCompiler)' == ''">&quot;$(_NativeWasmSdkBinPath)clang&quot;</CppCompiler>
      <CppLinker Condition="'$(CppLinker)' == ''">$(CppCompiler)</CppLinker>
    </PropertyGroup>
  </Target>
</Project>
