    spawn-target-indicator: func(position-x: f32, position-y: f32, position-z: f32, color-x: f32, color-y: f32, color-z: f32);
    spawn-unit-for-player: func(unit-type-id: string, position-x: f32, position-y: f32, player-index: s32, execute-spawn-shader: bool, bypass-population: bool) -> s32;
    spawn-visual-effect: func(effect-type-id: string, position-x: f32, position-y: f32, position-z: f32, scale: f32);
    start-countdown-timer: func(duration: f32, label: string);
    start-player-building-placement: func(player-index: s32, unit-type-id: string);
