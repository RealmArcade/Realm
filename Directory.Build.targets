<Project>

  <PropertyGroup>
    <RepoMapRoot>$(MSBuildThisFileDirectory)</RepoMapRoot>
    <RepoMapOutput>$(RepoMapRoot).context/REPO_MAP.md</RepoMapOutput>
    <BundledUvPath>$(RepoMapRoot)ThirdPartyBinaries/uv.exe</BundledUvPath>
  </PropertyGroup>

  <Target Name="GenerateAgentRepoMap"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Realm.Client' And '$(BuildingSolutionFile)' != 'true'">
    <Message Importance="high" Text="Generating C# AST repo map for AI agents..." />
    <MakeDir Directories="$(RepoMapRoot).context" />
    <Exec Command="where uv &gt;nul 2&gt;&amp;1" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="UvOnPathExitCode" />
    </Exec>
    <PropertyGroup>
      <UvCommand Condition="'$(UvOnPathExitCode)' == '0'">uv</UvCommand>
      <UvCommand Condition="'$(UvOnPathExitCode)' != '0'">&quot;$(BundledUvPath)&quot;</UvCommand>
    </PropertyGroup>
    <Exec Command="where ast-outline &gt;nul 2&gt;&amp;1 || $(UvCommand) tool install ast-outline" ContinueOnError="true" />
    <Exec Command="$(UvCommand) tool run ast-outline digest &quot;$(RepoMapRoot.TrimEnd('\'))&quot; &gt; &quot;$(RepoMapOutput)&quot;"
          WorkingDirectory="$(RepoMapRoot)"
          ContinueOnError="true" />
  </Target>

</Project>
