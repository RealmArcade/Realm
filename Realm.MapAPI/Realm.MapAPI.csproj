<Project Sdk="Microsoft.NET.Sdk">
 
   <PropertyGroup>
     <TargetFramework>net10.0</TargetFramework>
     <ImplicitUsings>enable</ImplicitUsings>
     <Nullable>enable</Nullable>
     <GenerateDocumentationFile>true</GenerateDocumentationFile>
     <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
     <WasmComponentWorld>game-client</WasmComponentWorld>
     <NoWarn>$(NoWarn);1591</NoWarn>
     <WitGeneratedFilesRoot>obj\$(Configuration)\$(TargetFramework)\wit_bindgen\</WitGeneratedFilesRoot>
   </PropertyGroup>
 
   <ItemGroup>
     <Wit Remove="wit\game.wit" />
     <Wit Remove="wit\game.g.wit" />
     <Wit Include="wit\game.g.wit" World="game-client" />
   </ItemGroup>

   <ItemGroup>
     <Compile Remove="MapTemplate\**" />
   </ItemGroup>
 
   <ItemGroup>
     <PackageReference Include="BytecodeAlliance.Componentize.DotNet.WitBindgen" Version="0.8.0-preview00011" />
   </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Realm.WasmBindgen\Realm.WasmBindgen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="AddXmlDocComment" AfterTargets="CoreCompile" Condition="'$(GenerateDocumentationFile)' == 'true'">
    <PropertyGroup>
      <XmlDocFile>$(IntermediateOutputPath)$(TargetName).xml</XmlDocFile>
    </PropertyGroup>
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="powershell -Command &quot;if (Test-Path '$(XmlDocFile)') { $p = '$(XmlDocFile)'; $c = '&lt;!-- This file is auto-generated by the Microsoft .NET SDK C# compiler (csc). Online documentation: https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/xmldoc/ --&gt;'; $old = Get-Content $p -Raw; if (-not $old.StartsWith($c)) { Set-Content -Path $p -Value ($c + [Environment]::NewLine + $old) } }&quot;" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="if [ -f '$(XmlDocFile)' ]; then HEADER='&lt;!-- This file is auto-generated by the Microsoft .NET SDK C# compiler (csc). Online documentation: https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/xmldoc/ --&gt;'; if ! head -n 1 '$(XmlDocFile)' | grep -q 'auto-generated'; then (echo &quot;$HEADER&quot;; cat '$(XmlDocFile)') &gt; '$(XmlDocFile).tmp' &amp;&amp; mv '$(XmlDocFile).tmp' '$(XmlDocFile)'; fi; fi" />
  </Target>

  <Target Name="CopyToMapTemplate" AfterTargets="Build">
    <ItemGroup>
      <_MapApiOutput Include="$(TargetDir)$(TargetName).dll" />
      <_MapApiOutput Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <_MapApiOutput Include="$(TargetDir)$(TargetName).xml" Condition="Exists('$(TargetDir)$(TargetName).xml')" />
    </ItemGroup>
     <Copy SourceFiles="@(_MapApiOutput)" DestinationFolder="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)\..\MapTemplate\lib'))\" SkipUnchangedFiles="true" />
  </Target>

</Project>
